# Copy to .env and adjust. Never commit the real .env.

PORT=3000

# WebAuthn relying-party settings.
# RP_ID must match the domain the browser sees. In dev that's "localhost".
RP_ID=localhost
RP_NAME=CS4389 Demo

# The full origin the frontend is served from. The passkey is bound to this.
# WebAuthn refuses to work if this doesn't match — that's the phishing defense.
ORIGIN=http://localhost:5173

# Secret for signing session tokens. Generate a random one per machine.
SESSION_SECRET=change-me-to-a-long-random-string
